generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 依頼の受付元。将来 gmail / teams などのアダプタを追加する際はここに値を足す。
enum SourceType {
  email
  slack
  form
}

enum Category {
  sales
  customer_success
  product
  design
  engineering
  marketing
  finance
  hr
  general_affairs
  legal
}

enum Priority {
  urgent
  high
  medium
  low
}

enum RequestStatus {
  todo
  in_progress
  done
}

/// AIの判定がそのまま使えるか、人間の確認が必要か
enum ReviewState {
  auto_assigned
  needs_review
  confirmed
}

enum Actor {
  ai
  human
  system
}

/// デモの作業スペース。訪問者（ブラウザ）ごとに 1 つ作り、依頼データをこの単位で分ける。
/// ある訪問者の操作が、ほかの訪問者の画面に反映されないようにするため。
model DemoSession {
  id         String    @id
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  requests   Request[]

  @@index([lastSeenAt])
}

/// 公開デモで OpenAI の利用量が増えすぎないよう、AI 分析の実行回数を数える（作業スペースを消しても残す）
model AiUsageLog {
  id        String   @id @default(cuid())
  sessionId String
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
}

/// NEXORA株式会社のメンバー（担当者候補）
model Member {
  id               String    @id
  name             String
  department       String
  role             String
  responsibilities String[]
  sortOrder        Int       @default(0)
  requests         Request[]
}

model Request {
  id              String        @id @default(cuid())
  sessionId       String
  session         DemoSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title           String
  sourceType      SourceType
  /// 受付元ごとの付帯情報（差出人・件名・チャンネルなど）。形は src/lib/ingestion の SourceMetadata 型を参照。
  sourceMetadata  Json
  requesterName   String
  originalMessage String

  summary         String
  category        Category
  priority        Priority
  assigneeId      String?
  assignee        Member?       @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewState     ReviewState
  dueDate         DateTime?     @db.Date
  nextAction      String
  replySubject    String
  replyDraft      String
  replySentAt     DateTime?

  /// AI が「過去のどの依頼の続きか」を特定した場合の関連先（例: 「先日の件」→ 元の依頼）
  relatedRequestId String?
  relatedRequest   Request?     @relation("RelatedRequest", fields: [relatedRequestId], references: [id], onDelete: SetNull)
  followUps        Request[]    @relation("RelatedRequest")

  status          RequestStatus @default(todo)
  receivedAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  analyses        AiAnalysis[]
  activities      ActivityLog[]

  @@index([status])
  @@index([receivedAt])
  @@index([sessionId, receivedAt])
  @@index([requesterName])
}

/// AIの分析結果そのもの（モデルの生出力を検証後に保存）。人が編集しても元の判断を追跡できるよう Request とは分けて持つ。
model AiAnalysis {
  id                 String   @id @default(cuid())
  requestId          String
  request            Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// openai / mock / seed
  provider           String
  model              String
  result             Json
  assigneeConfidence String
  latencyMs          Int?
  createdAt          DateTime @default(now())

  @@index([requestId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  requestId   String
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// 例: received / ai_summary / ai_assignee / status_changed / reply_sent
  type        String
  actor       Actor
  description String
  createdAt   DateTime @default(now())

  @@index([requestId, createdAt])
}
