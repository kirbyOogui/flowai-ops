# ─────────────────────────────────────────────
# FlowAI OPS 環境変数
# このファイルを .env にコピーして値を設定してください:  cp .env.example .env
# ─────────────────────────────────────────────

# PostgreSQL 接続文字列
# docker compose up -d で起動するローカルDBを使う場合は、この値のままで動きます。
# Supabase / Neon などを使う場合は、そのサービスの接続文字列に置き換えてください。
DATABASE_URL="postgresql://flowai:flowai@localhost:5433/flowai_ops?schema=public"

# AIプロバイダ
#   openai : 実際の OpenAI API で分析します（本番・デモ用）
#   mock   : APIキーなしで動く開発用のモックAI（キーワードで簡易判定）
AI_PROVIDER="openai"

# OpenAI API キー（サーバー側でのみ使用。クライアントには送られません）
# https://platform.openai.com/api-keys で発行してください。
OPENAI_API_KEY=""

# 使用するモデル（省略時: gpt-6-sol）
OPENAI_MODEL="gpt-6-sol"

# 推論の強さ（none / minimal / low / medium / high。省略時: low）
OPENAI_REASONING_EFFORT="low"

# 公開デモでの AI 分析の回数上限（24時間あたり。OpenAI の利用料が増えすぎないようにするため）
#   DEMO_AI_LIMIT_PER_SESSION : 1人（1ブラウザ）あたり（省略時: 20）
#   DEMO_AI_LIMIT_TOTAL       : デモ全体（省略時: 300）
DEMO_AI_LIMIT_PER_SESSION="20"
DEMO_AI_LIMIT_TOTAL="300"
